# Managed by ansible (roles/node-tuning). CUBRIDQA-1501 issue 17.
#
# The interval is the node_exporter scrape interval. A sample per scrape is
# what lets a 5m rate see the sustained spin rather than one busy moment.
[Unit]
Description=Sample the gha-ci FUSE client every {{ gha_ci_fuse_metrics_interval }}

[Timer]
OnBootSec=1min
OnUnitActiveSec={{ gha_ci_fuse_metrics_interval }}
AccuracySec=1s

[Install]
WantedBy=timers.target
