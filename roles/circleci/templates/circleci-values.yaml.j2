# CircleCI Container Agent Values - Minimal Override Configuration
# Only overrides specific values from runner.yml, uses Helm chart defaults for everything else

agent:
  replicaCount: {{ agent.replicas | default(1) }}
  maxConcurrentTasks: {{ agent.maxConcurrentTasks | default(20) }}
{% if agent.nodeSelector is defined %}
  nodeSelector:
{% for key, value in agent.nodeSelector.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% if agent.tolerations is defined %}
  tolerations:
{% for toleration in agent.tolerations %}
    - key: "{{ toleration.key }}"
      operator: "{{ toleration.operator }}"
      effect: "{{ toleration.effect }}"
{% endfor %}
{% endif %}

  # Resource class configuration with job container resources
  resourceClasses:
{% if job.namespace is defined and job.resource_class is defined and job.token is defined %}
    "{{ job.namespace }}/{{ job.resource_class }}":
      token: {{ job.token }}
      spec:
{% if job.spec.nodeSelector is defined %}
        nodeSelector:
{% for key, value in job.spec.nodeSelector.items() %}
          {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% if job.spec.topologySpreadConstraints is defined %}
        topologySpreadConstraints:
{% for constraint in job.spec.topologySpreadConstraints %}
          - maxSkew: {{ constraint.maxSkew }}
            topologyKey: "{{ constraint.topologyKey }}"
            whenUnsatisfiable: "{{ constraint.whenUnsatisfiable }}"
{% if constraint.labelSelector is defined %}
            labelSelector:
{% if constraint.labelSelector.matchLabels is defined %}
              matchLabels:
{% for key, value in constraint.labelSelector.matchLabels.items() %}
                {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
        shareProcessNamespace: true
        volumes:
          - name: goat-ephemeral
            emptyDir: {}            
        containers:
          - name: primary
            volumeMounts:
              - name: goat-ephemeral
                mountPath: /runner-init 
{% if job.spec.resources is defined %}
            resources:
              requests:
                cpu: "{{ job.spec.resources.requests.cpu }}"
                memory: "{{ job.spec.resources.requests.memory }}"
              limits:
                cpu: "{{ job.spec.resources.limits.cpu }}"
                memory: "{{ job.spec.resources.limits.memory }}"
{% endif %}
{% endif %}