# CircleCI Container Agent Values - Minimal Override Configuration
# Only overrides specific values from runner.yml, uses Helm chart defaults for everything else

agent:
  replicaCount: {{ circleci.replicas | default(1) }}
  maxConcurrentTasks: {{ circleci.maxConcurrentTasks | default(20) }}
  
  # Resource class configuration with job container resources
  resourceClasses:
    {% if circleci.namespace is defined and circleci.resource_class is defined and circleci.token is defined %}
    "{{ circleci.namespace }}/{{ circleci.resource_class }}":
      token: {{ circleci.token }}
      spec:
        shareProcessNamespace: true
        volumes:
          - name: goat-ephemeral
            emptyDir: {}            
        containers:
          - name: primary
            volumeMounts:
              - name: goat-ephemeral
                mountPath: /runner-init 
            {% if resources.job is defined %}
            resources:
              {% if resources.job.requests is defined %}
              requests:
                cpu: "{{ resources.job.requests.cpu }}"
                memory: "{{ resources.job.requests.memory }}"
              {% endif %}
              {% if resources.job.limits is defined %}
              limits:
                cpu: "{{ resources.job.limits.cpu }}"
                memory: "{{ resources.job.limits.memory }}"
              {% endif %}
            {% endif %}
    {% endif %}