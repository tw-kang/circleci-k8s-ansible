# CircleCI Container Runner Helm Values
# Official CircleCI Container Agent Helm Chart Configuration

agent:
  resourceClasses:
    {{ circleci.runner.namespace }}/{{ circleci.runner.resource_class }}:
      token: {{ circleci.runner.token }}

# Replica count for runner pods
replicaCount: {{ circleci.runner.replicas | default(2) }}

# Container image configuration
image:
  repository: "{{ circleci.runner.image.repository | default('circleci/runner-agent') }}"
  tag: "{{ circleci.runner.image.tag | default('kubernetes-3') }}"
  pullPolicy: "{{ circleci.runner.image.pullPolicy | default('Always') }}"

# Resource limits and requests for runner pods
resources:
{% if circleci.runner.resources is defined %}
  requests:
    cpu: "{{ circleci.runner.resources.requests.cpu | default('100m') }}"
    memory: "{{ circleci.runner.resources.requests.memory | default('256Mi') }}"
  limits:
    cpu: "{{ circleci.runner.resources.limits.cpu | default('500m') }}"
    memory: "{{ circleci.runner.resources.limits.memory | default('1Gi') }}"
{% else %}
  # Default minimum specifications (for testing)
  requests:
    cpu: "100m"
    memory: "256Mi"
  limits:
    cpu: "500m"
    memory: "1Gi"
{% endif %}

# Security context
securityContext:
  runAsUser: "{{ circleci.runner.security.runAsUser | default(0) }}"
  allowPrivilegeEscalation: "{{ circleci.runner.security.allowPrivilegeEscalation | default(false) }}"
  readOnlyRootFilesystem: "{{ circleci.runner.security.readOnlyRootFilesystem | default(false) }}"
  capabilities:
    drop:
      - ALL

# Node selector for architecture  
nodeSelector:
  kubernetes.io/arch: "{{ image_arch | default('amd64') }}"

# Tolerations for scheduling
tolerations:
  - operator: Exists
    effect: NoSchedule

# Environment variables
env:
  - name: CIRCLECI_RUNNER_API_URL
    value: "https://runner.circleci.com"
  - name: CIRCLECI_RESOURCE_CLASS
    value: "{{ circleci.runner.namespace }}/{{ circleci.runner.resource_class }}"

# Service account configuration
serviceAccount:
  create: true
  name: "{{ circleci.runner.service_account_name | default('container-agent') }}"

# RBAC configuration
rbac:
  create: true
  rules:
    - apiGroups: [""]
      resources: ["pods", "pods/log", "pods/exec"]
      verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
    - apiGroups: [""]
      resources: ["secrets", "configmaps"]
      verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
    - apiGroups: ["apps"]
      resources: ["deployments", "replicasets"]
      verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
    - apiGroups: ["batch"]
      resources: ["jobs"]
      verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]

# Namespace configuration
namespace:
  create: true
  name: "{{ circleci.runner.namespace }}"

# Logging level
logging:
  level: "{{ circleci.runner.logging.level | default('INFO') }}"

# Garbage collection settings
gc:
  enabled: "{{ circleci.runner.gc.enabled | default(true) }}"
  threshold: "{{ circleci.runner.gc.threshold | default('10m') }}"

# Maximum run time for jobs
maxRunTime: "{{ circleci.runner.maxRunTime | default('5h') }}"

# Pod template configuration  
{% if container_manager == 'containerd' %}
volumes:
  - name: container-sock
    hostPath:
      path: /var/run/containerd/containerd.sock
      type: Socket

volumeMounts:
  - name: container-sock
    mountPath: /var/run/containerd/containerd.sock
    readOnly: true
{% else %}
volumes:
  - name: container-sock
    hostPath:
      path: /var/run/docker.sock
      type: Socket

volumeMounts:
  - name: container-sock
    mountPath: /var/run/docker.sock
    readOnly: true
{% endif %} 