# CircleCI Container Agent Values - Simplified Configuration
# Dynamic values from runner.yml, static values hardcoded for stability

agent:
  replicaCount: {{ replicas | default(1) }}
  maxConcurrentTasks: {{ maxConcurrentTasks | default(20) }}
  nodeSelector:
    node-role.kubernetes.io/control-plane: ""
  tolerations:
    - key: "node-role.kubernetes.io/control-plane"
      operator: "Exists"
      effect: "NoSchedule"

  # Resource class configuration with dynamic values from runner.yml
  resourceClasses:
    "{{ namespace }}/{{ resource_class }}":
      token: "{{ token }}"
      spec:
        containers:
          - name: primary
            image: "{{ image }}"
            imagePullPolicy: Always
            securityContext:
              privileged: true
            resources:
              requests:
                cpu: "{{ resources.requests.cpu }}"
                memory: "{{ resources.requests.memory }}"
              limits:
                cpu: "{{ resources.limits.cpu }}"
                memory: "{{ resources.limits.memory }}"
            volumeMounts:
              - name: goat-ephemeral
                mountPath: /runner-init
              - name: repo-ro
                mountPath: /ro
                readOnly: true
              - name: overlay-rw
                mountPath: /rw
            lifecycle:
              postStart:
                exec:
                  command:
                    - /bin/sh
                    - -lc
                    - |
                      set -e
                      target="/home/cubrid-testcases-private-ex"
                      mkdir -p /rw/upper /rw/work "$target"
                      mount -t overlay overlay \
                        -o lowerdir=/ro,upperdir=/rw/upper,workdir=/rw/work "$target"

        volumes:
          - name: goat-ephemeral
            emptyDir: {}
          - name: repo-ro
            hostPath:
              path: /home/tc-repo/cubrid-testcases-private-ex
              type: Directory
          - name: overlay-rw
            emptyDir: {}

        nodeSelector:
          node-role.kubernetes.io/worker: ""

        topologySpreadConstraints:
          - maxSkew: 1
            topologyKey: "kubernetes.io/hostname"
            whenUnsatisfiable: "ScheduleAnyway"
            labelSelector:
              matchLabels:
                app.circleci.com/circle-job: test_shell

        shareProcessNamespace: true