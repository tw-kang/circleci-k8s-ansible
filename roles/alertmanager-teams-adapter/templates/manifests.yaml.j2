---
# alertmanager-teams-adapter — all K8s objects for the sidecar that
# translates AlertManager webhook payloads into the Adaptive Card
# envelope the Power Automate TeamsWebhook trigger expects.
# Rendered and applied by tasks/adapter.yml via from_yaml_all.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ am_teams_adapter_name }}-script
  namespace: {{ am_teams_adapter_namespace }}
  labels:
    app.kubernetes.io/name: {{ am_teams_adapter_name }}
    app.kubernetes.io/component: webhook-adapter
    app.kubernetes.io/managed-by: ansible
data:
  adapter.py: |
{{ lookup('ansible.builtin.file', role_path ~ '/files/adapter.py') | indent(width=4, first=True) }}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ am_teams_adapter_name }}-target
  namespace: {{ am_teams_adapter_namespace }}
  labels:
    app.kubernetes.io/name: {{ am_teams_adapter_name }}
    app.kubernetes.io/component: webhook-adapter
    app.kubernetes.io/managed-by: ansible
type: Opaque
stringData:
  TARGET_URL: "{{ am_teams_adapter_target_url }}"
---
apiVersion: v1
kind: Service
metadata:
  name: {{ am_teams_adapter_name }}
  namespace: {{ am_teams_adapter_namespace }}
  labels:
    app.kubernetes.io/name: {{ am_teams_adapter_name }}
    app.kubernetes.io/component: webhook-adapter
    app.kubernetes.io/managed-by: ansible
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: {{ am_teams_adapter_name }}
  ports:
    - name: http
      port: {{ am_teams_adapter_listen_port }}
      targetPort: http
      protocol: TCP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ am_teams_adapter_name }}
  namespace: {{ am_teams_adapter_namespace }}
  labels:
    app.kubernetes.io/name: {{ am_teams_adapter_name }}
    app.kubernetes.io/component: webhook-adapter
    app.kubernetes.io/managed-by: ansible
spec:
  # SPOF by design — adapter is cheap, control-plane co-located. AlertManager
  # buffers during the rolling-restart 0-pod window and retries after
  # repeat_interval (1h critical / 3h warning). See [[project_msteams_adapter_decision]].
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ am_teams_adapter_name }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ am_teams_adapter_name }}
        app.kubernetes.io/component: webhook-adapter
        app.kubernetes.io/managed-by: ansible
      annotations:
        # Restart pods automatically when the script ConfigMap or the
        # target-URL Secret content changes. The hash is computed in the
        # task file and threaded through as `_am_teams_adapter_hash`.
        omc.ansible/config-hash: "{{ _am_teams_adapter_hash }}"
    spec:
      nodeSelector:
        node-role.kubernetes.io/control-plane: ""
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: adapter
          image: {{ am_teams_adapter_image }}
          imagePullPolicy: IfNotPresent
          command:
            - python3
            - /opt/adapter/adapter.py
          env:
            - name: LISTEN_PORT
              value: "{{ am_teams_adapter_listen_port }}"
            - name: PYTHONUNBUFFERED
              value: "1"
          envFrom:
            - secretRef:
                name: {{ am_teams_adapter_name }}-target
          ports:
            - name: http
              containerPort: {{ am_teams_adapter_listen_port }}
              protocol: TCP
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 2
            periodSeconds: 10
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 10
            periodSeconds: 20
            failureThreshold: 3
          resources:
            requests:
              cpu: 20m
              memory: 32Mi
            limits:
              cpu: 200m
              memory: 128Mi
          volumeMounts:
            - name: script
              mountPath: /opt/adapter
              readOnly: true
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
      volumes:
        - name: script
          configMap:
            name: {{ am_teams_adapter_name }}-script
            defaultMode: 0444
