#!/bin/bash
# gha-ci 의 repo seed 갱신. `repos/<name>.git` 은 bare mirror 고,
# `repos/<name>/` 은 그 미러에서 하드링크로 뜬 worktree seed 다.
set -euo pipefail

ROOT="{{ arc_repo_seed_root }}"
RETIRE_MIN=$(( {{ arc_repo_seed_retire_hours }} * 60 ))
NOW=$(date -u +%s)
RC=0

for c in git curl openssl base64 sed; do
  command -v "$c" >/dev/null || { echo "!! $c is not in {{ arc_repo_seed_image }}"; exit 1; }
done

mkdir -p "$ROOT"

# shard 가 물러난 세대를 overlay lowerdir 로 아직 물고 있을 수 있다. shard 의
# timeout-minutes 가 120 이므로 그보다 오래된 것만 지운다.
find "$ROOT" -maxdepth 1 -name '*.retired.*' -type d -mmin +"$RETIRE_MIN" \
  -print -exec rm -rf {} + || true
# 앞선 실행이 죽어 남긴 미완성 세대. concurrencyPolicy 가 Forbid 라 지금 도는 것은 없다.
find "$ROOT" -maxdepth 1 -name '*.new.*' -type d -print -exec rm -rf {} + || true

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# 비공개 repo 용 1 시간 installation token. 워크플로가 쓰는 App 과 같은 것이다.
mint_token() {
  local iat hdr pay sig
  iat=$(( $(date -u +%s) - 60 ))
  hdr=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
  pay=$(printf '{"iat":%s,"exp":%s,"iss":"%s"}' \
        "$iat" "$((iat + 540))" "$(cat /creds/app_id)" | b64url)
  sig=$(printf '%s.%s' "$hdr" "$pay" \
        | openssl dgst -sha256 -sign /creds/private_key -binary | b64url)
  curl -sS -X POST \
    -H "Authorization: Bearer ${hdr}.${pay}.${sig}" \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' \
    -d "{\"repositories\":[\"$1\"],\"permissions\":{\"contents\":\"read\"}}" \
    "https://api.github.com/app/installations/$(cat /creds/installation_id)/access_tokens" \
    | sed -n 's/.*"token" *: *"\([^"]*\)".*/\1/p'
}

# 토큰은 env 로만 준다 — remote URL 에 박으면 GlusterFS 의 .git/config 에 그대로 앉는다.
# git 이 실패하면 rewrite 된 URL 을 그대로 찍으므로 출력에서 가린다.
git_as() {
  local t=$1; shift
  if [ -n "$t" ]; then
    GIT_CONFIG_COUNT=1 \
    GIT_CONFIG_KEY_0="url.https://x-access-token:${t}@github.com/.insteadOf" \
    GIT_CONFIG_VALUE_0="https://github.com/" \
    git "$@" 2>&1 | sed 's#x-access-token:[^@]*@#x-access-token:***@#g'
  else
    git "$@" 2>&1
  fi
}

refresh_mirror() {
  local name=$1 url=$2 tok=$3 m g
  m="$ROOT/${name}.git"
  if [ -d "$m" ]; then
    # 41 이 옛 볼륨에서 rsync 해 온 미러다. 어떤 설정으로 만들어졌는지 코드 밖이라
    # 매번 세우고, refspec 은 손대지 않고 찍기만 한다 — 좁게 만든 이유가 있을 수 있다.
    git -C "$m" config gc.auto 0
    git -C "$m" remote set-url origin "$url"
    echo "[mirror] $name fetch=$(git -C "$m" config --get-all remote.origin.fetch | tr '\n' ' ')" \
         "mirror=$(git -C "$m" config --get remote.origin.mirror || echo -)"
    git_as "$tok" -C "$m" remote update --prune
  else
    g="${m}.new.${NOW}"
    git_as "$tok" clone --mirror "$url" "$g"
    git -C "$g" config gc.auto 0
    mv -T "$g" "$m"
  fi
  printf 'refreshed_at\t%s\nhead\t%s\n' \
    "$(date -u +%FT%TZ)" "$(git -C "$m" rev-parse HEAD)" > "${m}.stamp"
}

refresh_worktree() {
  local name=$1 url=$2 branch=$3 m s want have g
  m="$ROOT/${name}.git"
  s="$ROOT/${name}"
  want=$(git -C "$m" rev-parse "refs/heads/${branch}")
  have=""
  [ -d "$s/.git" ] && have=$(git -C "$s" rev-parse HEAD 2>/dev/null || echo "")
  if [ "$want" = "$have" ]; then
    echo "[seed] $name unchanged at $want"
    return 0
  fi
  g="${s}.new.${NOW}"
  # 같은 볼륨의 로컬 경로라 git 이 객체를 하드링크한다. 바이트를 다시 쓰지 않고,
  # 미러에서 그 객체가 사라져도 링크가 inode 를 붙잡는다.
  git clone -q --branch "$branch" "$m" "$g"
  git -C "$g" config gc.auto 0
  # pod 의 정렬 단계가 `origin` 으로 fetch 한다. 로컬 미러 경로면 상류를 못 본다.
  git -C "$g" remote set-url origin "$url"
  [ -e "$s" ] && mv -T "$s" "${s}.retired.${NOW}"
  mv -T "$g" "$s"
  printf 'refreshed_at\t%s\nhead\t%s\nbranch\t%s\n' \
    "$(date -u +%FT%TZ)" "$want" "$branch" > "${s}.stamp"
  echo "[seed] $name -> $want"
}

do_repo() {
  local name=$1 url=$2 private=$3 worktree=$4 branch=$5 tok=""
  echo "=== $name"
  if [ "$private" = yes ]; then
    tok=$(mint_token "$name") || tok=""
    [ -n "$tok" ] || { echo "!! could not mint a token for $name"; return 1; }
  fi
  refresh_mirror "$name" "$url" "$tok" || { echo "!! mirror of $name failed"; return 1; }
  [ "$worktree" = yes ] || return 0
  refresh_worktree "$name" "$url" "$branch" \
    || { echo "!! worktree seed of $name failed"; return 1; }
}

{% for r in arc_repo_seed_repos %}
do_repo '{{ r.name }}' '{{ r.url }}' \
        '{{ "yes" if r.private | default(false) else "no" }}' \
        '{{ "yes" if r.worktree | default(false) else "no" }}' \
        '{{ r.branch | default("develop") }}' || RC=1
{% endfor %}

df -h "$ROOT" || true
exit "$RC"
