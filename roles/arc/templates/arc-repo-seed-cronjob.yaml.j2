---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ arc_repo_seed_name }}
  namespace: {{ arc_repo_seed_namespace }}
  labels:
    app: {{ arc_repo_seed_name }}
    app.kubernetes.io/managed-by: ansible
data:
  seed.sh: |
    {{ lookup('template', 'arc-repo-seed.sh.j2') | indent(4) }}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{ arc_repo_seed_name }}
  namespace: {{ arc_repo_seed_namespace }}
  labels:
    app: {{ arc_repo_seed_name }}
    app.kubernetes.io/managed-by: ansible
spec:
  schedule: "{{ arc_repo_seed_schedule }}"
  timeZone: "Asia/Seoul"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 1
      activeDeadlineSeconds: {{ arc_repo_seed_deadline_seconds }}
      template:
        metadata:
          labels:
            app: {{ arc_repo_seed_name }}
        spec:
          restartPolicy: OnFailure
          # GlusterFS 는 kube_node 만 마운트한다.
          nodeSelector:
            node-role.kubernetes.io/worker: ""
          containers:
            - name: seed
              image: {{ arc_repo_seed_image }}
              imagePullPolicy: IfNotPresent
              securityContext:
                runAsUser: 0
                runAsGroup: 0
              command: ["/bin/bash", "/script/seed.sh"]
              resources:
                requests:
                  cpu: "1"
                  memory: "1Gi"
                limits:
                  cpu: "4"
                  memory: "8Gi"
              volumeMounts:
                - name: script
                  mountPath: /script
                  readOnly: true
                - name: creds
                  mountPath: /creds
                  readOnly: true
                - name: gha-ci
                  mountPath: {{ arc_storage_root }}
                - name: work
                  mountPath: /work
          volumes:
            - name: script
              configMap:
                name: {{ arc_repo_seed_name }}
                defaultMode: 0755
            - name: creds
              secret:
                secretName: {{ arc_repo_seed_name }}-gh-app
                defaultMode: 0400
            - name: gha-ci
              hostPath:
                path: {{ arc_storage_root }}
                type: Directory
            # 노드 디스크다. GlusterFS 위의 index-pack 을 피해 여기서 clone 한다.
            - name: work
              emptyDir:
                sizeLimit: {{ arc_repo_seed_work_size }}
