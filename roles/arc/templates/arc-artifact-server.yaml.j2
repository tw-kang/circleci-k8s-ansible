---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ arc_artifact_server_name }}-nginx
  namespace: {{ arc_artifact_server_namespace }}
  labels:
    app: {{ arc_artifact_server_name }}
    app.kubernetes.io/managed-by: ansible
data:
  nginx.conf: |
    # 기본 사용자 nobody 로는 못 읽는 파일을 shard 가 남긴다.
    user root;
    worker_processes 1;
    error_log /dev/stderr warn;
    pid /tmp/nginx.pid;

    events { worker_connections 256; }

    http {
      access_log /dev/stdout;

      # mime.types 를 include 하면 xml 이 겹쳐 파싱이 깨진다.
      types {
        text/plain  log data list tsv txt xml sql answer md conf yaml yml;
        text/html   html htm;
        application/gzip tgz gz;
      }
      default_type application/octet-stream;
      charset utf-8;

      # FUSE(GlusterFS) 위에서 믿을 수 없다.
      sendfile off;
      server_tokens off;

      server {
        listen {{ arc_artifact_server_container_port }};
        root /srv/artifacts;

        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;

        location = /healthz {
          access_log off;
          return 200 "ok\n";
        }

        # 실패 run 마다 CTP seed 59MB. 읽을 사람이 없다.
        location ~ ^/runs/[^/]+/testtools/ {
          return 404;
        }
      }
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ arc_artifact_server_name }}
  namespace: {{ arc_artifact_server_namespace }}
  labels:
    app: {{ arc_artifact_server_name }}
    app.kubernetes.io/managed-by: ansible
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ arc_artifact_server_name }}
  template:
    metadata:
      labels:
        app: {{ arc_artifact_server_name }}
    spec:
      # GlusterFS 는 kube_node 만 마운트한다.
      nodeSelector:
        node-role.kubernetes.io/worker: ""
      containers:
        - name: nginx
          image: {{ arc_artifact_server_image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsUser: 0
            runAsGroup: 0
          ports:
            - name: http
              containerPort: {{ arc_artifact_server_container_port }}
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 2
            periodSeconds: 10
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              cpu: 500m
              memory: 256Mi
          volumeMounts:
            - name: conf
              mountPath: /etc/nginx/nginx.conf
              subPath: nginx.conf
              readOnly: true
            - name: artifacts
              mountPath: /srv/artifacts
              readOnly: true
      volumes:
        - name: conf
          configMap:
            name: {{ arc_artifact_server_name }}-nginx
        # 루트가 아니라 gha-ci 하위다. {{ arc_fork_build_cache_root }} 는 바깥
        # 기여자의 PR 이 쓰는 자리라 서빙하지 않는다.
        - name: artifacts
          hostPath:
            path: {{ arc_artifact_server_root }}
            type: Directory
---
apiVersion: v1
kind: Service
metadata:
  name: {{ arc_artifact_server_name }}
  namespace: {{ arc_artifact_server_namespace }}
  labels:
    app: {{ arc_artifact_server_name }}
    app.kubernetes.io/managed-by: ansible
spec:
  type: NodePort
  selector:
    app: {{ arc_artifact_server_name }}
  ports:
    - name: http
      port: 80
      targetPort: http
      nodePort: {{ arc_artifact_server_node_port }}
