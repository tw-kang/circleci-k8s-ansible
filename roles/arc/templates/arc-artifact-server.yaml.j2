---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ arc_artifact_server_name }}-nginx
  namespace: {{ arc_artifact_server_namespace }}
  labels:
    app: {{ arc_artifact_server_name }}
    app.kubernetes.io/managed-by: ansible
data:
  nginx.conf: |
{{ lookup('template', 'arc-artifact-nginx.conf.j2') | indent(4, true) }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ arc_artifact_server_name }}
  namespace: {{ arc_artifact_server_namespace }}
  labels:
    app: {{ arc_artifact_server_name }}
    app.kubernetes.io/managed-by: ansible
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ arc_artifact_server_name }}
  template:
    metadata:
      labels:
        app: {{ arc_artifact_server_name }}
      annotations:
        checksum/config: "{{ lookup('template', 'arc-artifact-nginx.conf.j2') | hash('sha1') }}"
    spec:
      nodeSelector:
        node-role.kubernetes.io/worker: ""
      containers:
        - name: nginx
          image: {{ arc_artifact_server_image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsUser: 0
            runAsGroup: 0
          ports:
            - name: http
              containerPort: {{ arc_artifact_server_container_port }}
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 2
            periodSeconds: 10
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              cpu: 500m
              memory: 256Mi
          volumeMounts:
            - name: conf
              mountPath: /etc/nginx/nginx.conf
              subPath: nginx.conf
              readOnly: true
            - name: artifacts
              mountPath: /srv/artifacts
              readOnly: true
      volumes:
        - name: conf
          configMap:
            name: {{ arc_artifact_server_name }}-nginx
        - name: artifacts
          hostPath:
            path: {{ arc_artifact_server_root }}
            type: Directory
---
apiVersion: v1
kind: Service
metadata:
  name: {{ arc_artifact_server_name }}
  namespace: {{ arc_artifact_server_namespace }}
  labels:
    app: {{ arc_artifact_server_name }}
    app.kubernetes.io/managed-by: ansible
spec:
  type: NodePort
  selector:
    app: {{ arc_artifact_server_name }}
  ports:
    - name: http
      port: 80
      targetPort: http
      nodePort: {{ arc_artifact_server_node_port }}
