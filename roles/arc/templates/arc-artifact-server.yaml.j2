{#
  gha-ci 산출물을 사내망에 HTTP 로 내보내는 읽기 전용 서버.
  gha-ci.yml 의 run summary 가 여기로 링크한다 (ARTIFACT_URL_BASE).

  주의: 이 파일의 `#` 주석은 렌더 결과에 그대로 들어간다. role 설명은 지금 이
  Jinja 주석 안에 쓴다. README.md "검증 — 골든 파일 대조" 참조.
#}
# gha-ci 산출물 열람 서버. roles/arc 가 만든다 — 손으로 고치지 마라.
#
# pod 는 워커에만 뜬다. GlusterFS 는 kube_node 만 마운트한다
# (playbooks/cluster-only.yml). NodePort 는 모든 노드 IP 에서 답하므로 URL 은
# 마스터 IP 를 쓴다 — Grafana(32000)와 같은 대역이라 워커의 다른 서브넷을
# 사용자에게 노출하지 않는다.
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ arc_artifact_server_name }}-nginx
  namespace: {{ arc_artifact_server_namespace }}
  labels:
    app: {{ arc_artifact_server_name }}
    app.kubernetes.io/managed-by: ansible
data:
  nginx.conf: |
    # worker 프로세스가 파일을 읽는다. CTP shard 가 떨어뜨리는 파일이 전부
    # world-readable 이라는 보장이 없고, nginx 의 기본 사용자는 nobody 다.
    user root;
    worker_processes 1;
    error_log /dev/stderr warn;
    pid /tmp/nginx.pid;

    events { worker_connections 256; }

    http {
      access_log /dev/stdout;

      # mime.types 를 일부러 include 하지 않는다. 그 파일이 xml 을 text/xml 로
      # 잡아서, 같은 확장자를 다시 적는 types 블록과 충돌한다.
      types {
        text/plain  log data list tsv txt xml sql answer md conf yaml yml;
        text/html   html htm;
        application/gzip tgz gz;
      }
      default_type application/octet-stream;
      charset utf-8;

      # FUSE 마운트(GlusterFS) 위에서 sendfile 은 믿을 수 없다.
      sendfile off;
      server_tokens off;

      server {
        listen {{ arc_artifact_server_container_port }};
        root /srv/artifacts;

        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;

        location = /healthz {
          access_log off;
          return 200 "ok\n";
        }

        # 실패 run 하나당 CTP seed 59MB 다. 읽을 사람이 없다.
        location ~ ^/runs/[^/]+/testtools/ {
          return 404;
        }
      }
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ arc_artifact_server_name }}
  namespace: {{ arc_artifact_server_namespace }}
  labels:
    app: {{ arc_artifact_server_name }}
    app.kubernetes.io/managed-by: ansible
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ arc_artifact_server_name }}
  template:
    metadata:
      labels:
        app: {{ arc_artifact_server_name }}
    spec:
      nodeSelector:
        node-role.kubernetes.io/worker: ""
      containers:
        - name: nginx
          image: {{ arc_artifact_server_image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsUser: 0
            runAsGroup: 0
          ports:
            - name: http
              containerPort: {{ arc_artifact_server_container_port }}
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 2
            periodSeconds: 10
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              cpu: 500m
              memory: 256Mi
          volumeMounts:
            - name: conf
              mountPath: /etc/nginx/nginx.conf
              subPath: nginx.conf
              readOnly: true
            - name: artifacts
              mountPath: /srv/artifacts
              readOnly: true
      volumes:
        - name: conf
          configMap:
            name: {{ arc_artifact_server_name }}-nginx
        # gha-ci 하위만 내보낸다. {{ arc_fork_build_cache_root }} 는 fork lane 의
        # 루트다 — 바깥 기여자의 PR 이 쓰는 자리라 서빙 대상에서 뺀다.
        - name: artifacts
          hostPath:
            path: {{ arc_artifact_server_root }}
            type: Directory
---
apiVersion: v1
kind: Service
metadata:
  name: {{ arc_artifact_server_name }}
  namespace: {{ arc_artifact_server_namespace }}
  labels:
    app: {{ arc_artifact_server_name }}
    app.kubernetes.io/managed-by: ansible
spec:
  type: NodePort
  selector:
    app: {{ arc_artifact_server_name }}
  ports:
    - name: http
      port: 80
      targetPort: http
      nodePort: {{ arc_artifact_server_node_port }}
