---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ arc_artifact_server_name }}-nginx
  namespace: {{ arc_artifact_server_namespace }}
  labels:
    app: {{ arc_artifact_server_name }}
    app.kubernetes.io/managed-by: ansible
data:
  nginx.conf: |
{{ lookup('template', 'arc-artifact-nginx.conf.j2') | indent(4, true) }}
  index.xsl: |
{{ lookup('template', 'arc-artifact-index.xsl.j2') | indent(4, true) }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ arc_artifact_server_name }}
  namespace: {{ arc_artifact_server_namespace }}
  labels:
    app: {{ arc_artifact_server_name }}
    app.kubernetes.io/managed-by: ansible
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ arc_artifact_server_name }}
  template:
    metadata:
      labels:
        app: {{ arc_artifact_server_name }}
      annotations:
        # nginx 는 실행 중에 설정을 다시 안 읽는다. ConfigMap 만 갱신하면 파일은
        # 바뀌어도 도는 nginx 는 옛 설정 그대로다. 이 해시가 바뀔 때만 pod 가 돈다.
        checksum/config: "{{ (lookup('template', 'arc-artifact-nginx.conf.j2')
                              ~ lookup('template', 'arc-artifact-index.xsl.j2')) | hash('sha1') }}"
    spec:
      # GlusterFS 는 kube_node 만 마운트한다.
      nodeSelector:
        node-role.kubernetes.io/worker: ""
      containers:
        - name: nginx
          image: {{ arc_artifact_server_image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsUser: 0
            runAsGroup: 0
          ports:
            - name: http
              containerPort: {{ arc_artifact_server_container_port }}
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 2
            periodSeconds: 10
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              cpu: 500m
              memory: 256Mi
          volumeMounts:
            - name: conf
              mountPath: /etc/nginx/nginx.conf
              subPath: nginx.conf
              readOnly: true
            - name: conf
              mountPath: /etc/nginx/index.xsl
              subPath: index.xsl
              readOnly: true
            - name: artifacts
              mountPath: /srv/artifacts
              readOnly: true
      volumes:
        - name: conf
          configMap:
            name: {{ arc_artifact_server_name }}-nginx
        # 볼륨 루트다. fork lane 이 그 하위(`_fork`)라 nginx 가 404 로 막는다.
        - name: artifacts
          hostPath:
            path: {{ arc_artifact_server_root }}
            type: Directory
---
apiVersion: v1
kind: Service
metadata:
  name: {{ arc_artifact_server_name }}
  namespace: {{ arc_artifact_server_namespace }}
  labels:
    app: {{ arc_artifact_server_name }}
    app.kubernetes.io/managed-by: ansible
spec:
  type: NodePort
  selector:
    app: {{ arc_artifact_server_name }}
  ports:
    - name: http
      port: 80
      targetPort: http
      nodePort: {{ arc_artifact_server_node_port }}
