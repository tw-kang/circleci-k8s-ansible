# autoindex 를 표로 그리는 데 쓴다. 공식 이미지에서 동적 모듈이라 실어야 한다.
load_module modules/ngx_http_xslt_filter_module.so;

# 기본 사용자 nobody 로는 못 읽는 파일을 shard 가 남긴다.
user root;
worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events { worker_connections 256; }

http {
  access_log /dev/stdout;

  # mime.types 를 include 하면 xml 이 겹쳐 파싱이 깨진다.
  # ⚠ `xml` 을 여기서 빼면 test-shell.xml 이 text/xml 로 나가고, 아래 XSLT
  #   필터가 목록인 줄 알고 그것까지 변환한다.
  types {
    text/plain  log data list tsv txt xml sql answer md conf yaml yml;
    text/html   html htm;
    application/gzip tgz gz;
  }
  default_type application/octet-stream;
  charset utf-8;

  # FUSE(GlusterFS) 위에서 믿을 수 없다.
  sendfile off;
  server_tokens off;

  server {
    listen {{ arc_artifact_server_container_port }};
    root /srv/artifacts;

    autoindex on;
    # autoindex 에는 정렬 지시어가 없다. XML 로 받아 index.xsl 이 표로 그리고
    # 최신 먼저로 세운다. 그래서 autoindex_exact_size·autoindex_localtime 은
    # 안 쓴다 — 둘 다 HTML 출력에만 걸리고, 크기와 시각은 index.xsl 이 쓴다.
    autoindex_format xml;
    xslt_stylesheet /etc/nginx/index.xsl;

    location = /healthz {
      access_log off;
      return 200 "ok\n";
    }

    # 실패 run 마다 CTP seed 59MB. 읽을 사람이 없다. `plan/` 은 run 디렉토리
    # 재배치 뒤 자리이고, 그 앞은 볼륨에 남아 있는 옛 run 의 자리다.
    location ~ ^/runs/[^/]+/(plan/)?testtools/ {
      return 404;
    }

    # 서빙 루트가 볼륨 루트라 fork lane 이 그 안에 든다. 바깥 기여자의 PR 이
    # 쓰는 자리다.
    location ~ ^/_fork(/|$) {
      return 404;
    }
  }
}
