user root;
worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events { worker_connections 256; }

http {
  access_log /dev/stdout;

  types {
    text/plain  log data list tsv txt xml sql answer md conf yaml yml;
    text/html   html htm;
    application/gzip tgz gz;
  }
  default_type application/octet-stream;
  charset utf-8;

  sendfile off;
  server_tokens off;

  server {
    listen {{ arc_artifact_server_container_port }};
    root /srv/artifacts;

    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;

    location = /healthz {
      access_log off;
      return 200 "ok\n";
    }

    location ~ ^/runs/[^/]+/(plan/)?testtools/ {
      return 404;
    }

    location ~ ^/_fork(/|$) {
      return 404;
    }
  }
}
