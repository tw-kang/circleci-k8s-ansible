apiVersion: v1
kind: PodTemplate
metadata:
  name: {{ arc_lane.release }}-pod-template
  labels:
    {{ arc_lane.release }}: "true"
    gha-ci.cubrid.org/lane: "{{ arc_lane.name }}"
spec:
  shareProcessNamespace: true

  containers:
    - name: $job
      imagePullPolicy: Always

      command: ["/bin/sh"]
      args:
        - -c
        - >-
          s=$(command -v sleep) &&
          cp -f "$s" /usr/local/bin/arc-keepalive 2>/dev/null &&
          exec /usr/local/bin/arc-keepalive infinity;
          exec sleep infinity

      securityContext:
        privileged: true

      env:
        - name: LOGNAME
          value: root

      resources:
        requests:
          cpu: "{{ arc_job_resources.requests.cpu }}"
          memory: {{ arc_job_resources.requests.memory }}
        limits:
          cpu: "{{ arc_job_resources.limits.cpu }}"
          memory: {{ arc_job_resources.limits.memory }}

      volumeMounts:
        - name: overlay-rw
          mountPath: /rw

        - name: build-overlay-rw
          mountPath: /build-rw

        - name: shared
          mountPath: {{ arc_shared_root }}
        - name: seed
          mountPath: {{ arc_seed_root }}
          readOnly: true
        - name: cache
          mountPath: {{ arc_cache_root }}

  volumes:
    - name: shared
      hostPath:
        path: {{ arc_lane.shared_root }}
        type: Directory

    - name: seed
      hostPath:
        path: {{ arc_seed_root }}
        type: DirectoryOrCreate

    - name: cache
      hostPath:
        path: {{ arc_cache_root }}
        type: DirectoryOrCreate

    - name: overlay-rw
      emptyDir:
        medium: Memory
        sizeLimit: {{ arc_tmpfs_testcases }}

    - name: build-overlay-rw
      emptyDir:
        medium: Memory
        sizeLimit: {{ arc_tmpfs_build }}
