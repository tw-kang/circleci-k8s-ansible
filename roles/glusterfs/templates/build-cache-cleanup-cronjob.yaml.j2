apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{ glusterfs_cleanup_cronjob_name }}
  namespace: {{ glusterfs_cleanup_namespace }}
spec:
  schedule: "{{ glusterfs_cleanup_schedule }}"
  timeZone: "Asia/Seoul"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 1
      activeDeadlineSeconds: {{ glusterfs_cleanup_deadline_seconds }}
      template:
        spec:
          restartPolicy: OnFailure
          nodeSelector:
{% for k, v in glusterfs_cleanup_node_selector.items() %}
            {{ k }}: "{{ v }}"
{% endfor %}
          containers:
            - name: cleanup
              image: {{ glusterfs_cleanup_image }}
              imagePullPolicy: IfNotPresent
              securityContext:
                runAsUser: 0
                runAsGroup: 0
              command:
                - /bin/sh
                - -lc
              args:
                - |
                  set -eu
                  RC=0
                  LIST=/tmp/prune.list

                  echo "[cleanup] start $(date -u +%Y-%m-%dT%H:%M:%SZ)"
{% for mp in glusterfs_cleanup_mounts %}
                  df -h "{{ mp }}" | tail -1
                  df -i "{{ mp }}" | tail -1
{% endfor %}

                  # RC instead of set -e: one bad path must not cost the others
                  # their prune. A path that is gone counts as bad -- the volume
                  # is not mounted here, and pruning nothing must not read green.
                  set --{% for e in glusterfs_cleanup_dirs %} "{{ e.path }}|{{ e.days }}"{% endfor %}

                  for SPEC in "$@"; do
                    PRUNE_DIR=${SPEC%|*}
                    DAYS=${SPEC#*|}
                    if [ ! -d "$PRUNE_DIR" ]; then
                      echo "[cleanup] ERROR: not found: $PRUNE_DIR"
                      RC=1
                      continue
                    fi
                    T0=$(date +%s)
                    find "$PRUNE_DIR" -mindepth 1 -maxdepth 1 -type d -mtime +"$DAYS" > "$LIST"
                    sed 's/^/[cleanup]   /' "$LIST"
                    while IFS= read -r VICTIM; do
                      rm -rf "$VICTIM" || { echo "[cleanup] ERROR: rm failed: $VICTIM"; RC=1; }
                    done < "$LIST"
                    echo "[cleanup] $PRUNE_DIR ${DAYS}d: $(wc -l < "$LIST") removed in $(( $(date +%s) - T0 ))s"
                  done

                  set --{% for e in glusterfs_cleanup_staging %} "{{ e.path }}|{{ e.days }}"{% endfor %}

                  for SPEC in "$@"; do
                    PRUNE_DIR=${SPEC%|*}
                    DAYS=${SPEC#*|}
                    if [ ! -d "$PRUNE_DIR" ]; then
                      echo "[cleanup] ERROR: not found: $PRUNE_DIR"
                      RC=1
                      continue
                    fi
                    find "$PRUNE_DIR" -mindepth 3 -maxdepth 3 -type d \
                      \( -name '*.tmp.*' -o -name '*.old.*' \) -mtime +"$DAYS" > "$LIST"
                    sed 's/^/[cleanup]   /' "$LIST"
                    while IFS= read -r VICTIM; do
                      rm -rf "$VICTIM" || { echo "[cleanup] ERROR: rm failed: $VICTIM"; RC=1; }
                    done < "$LIST"
                    echo "[cleanup] $PRUNE_DIR staging ${DAYS}d: $(wc -l < "$LIST") removed"
                  done

{% for mp in glusterfs_cleanup_mounts %}
                  df -h "{{ mp }}" | tail -1
                  df -i "{{ mp }}" | tail -1
{% endfor %}
                  echo "[cleanup] done rc=$RC"
                  exit "$RC"
              volumeMounts:
{% for mp in glusterfs_cleanup_mounts %}
                - name: {{ mp | regex_replace('[^a-z0-9]+', '-') | trim('-') }}
                  mountPath: "{{ mp }}"
{% endfor %}
          volumes:
{% for mp in glusterfs_cleanup_mounts %}
            - name: {{ mp | regex_replace('[^a-z0-9]+', '-') | trim('-') }}
              hostPath:
                path: "{{ mp }}"
                type: Directory
{% endfor %}
