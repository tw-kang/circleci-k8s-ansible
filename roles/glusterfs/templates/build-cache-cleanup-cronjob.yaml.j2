apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{ glusterfs_cleanup_cronjob_name }}
  namespace: {{ glusterfs_cleanup_namespace }}
spec:
  schedule: "{{ glusterfs_cleanup_schedule }}"
  timeZone: "Asia/Seoul"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 1
      template:
        spec:
          restartPolicy: OnFailure
          nodeSelector:
{% for k, v in glusterfs_cleanup_node_selector.items() %}
            {{ k }}: "{{ v }}"
{% endfor %}
          containers:
            - name: cleanup
              image: {{ glusterfs_cleanup_image }}
              imagePullPolicy: IfNotPresent
              securityContext:
                runAsUser: 0
                runAsGroup: 0
              command:
                - /bin/sh
                - -lc
              args:
                - |
                  set -eu
                  MOUNT_POINT="{{ glusterfs_mount_point }}"
                  RETENTION_DAYS="{{ glusterfs_cleanup_retention_days }}"
                  set --{% for dir in glusterfs_cleanup_dirs %} "{{ dir }}"{% endfor %}

                  echo "[cleanup] mount=$MOUNT_POINT retention=${RETENTION_DAYS}d dirs=$#"
                  # One bad path must not cost the others their prune, so the
                  # failure is recorded and reported at the end instead of
                  # tripping set -e halfway through the list.
                  RC=0
                  for PRUNE_DIR in "$@"; do
                    if [ ! -d "$PRUNE_DIR" ]; then
                      echo "[cleanup] directory not found: $PRUNE_DIR (skip)"
                      continue
                    fi
                    echo "[cleanup] pruning $PRUNE_DIR"
                    find "$PRUNE_DIR" -mindepth 1 -maxdepth 1 -type d -mtime +"$RETENTION_DAYS" -print -exec rm -rf {} \; \
                      || { echo "[cleanup] ERROR: prune failed for $PRUNE_DIR"; RC=1; }
                  done
                  df -h "$MOUNT_POINT" 2>/dev/null || true
                  exit "$RC"
              volumeMounts:
                - name: build-cache
                  mountPath: "{{ glusterfs_mount_point }}"
          volumes:
            - name: build-cache
              hostPath:
                path: "{{ glusterfs_mount_point }}"
                type: Directory
