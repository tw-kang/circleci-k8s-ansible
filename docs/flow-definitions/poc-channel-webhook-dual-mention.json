            "actions": {
                "반복_적용": {
                    "foreach": "@triggerBody()?['alerts']",
                    "actions": {
                        "primaryName": {
                            "type": "Compose",
                            "inputs": "@split(coalesce(item()?['labels']?['owner_email_primary'],''),'@')[0]",
                            "runAfter": {}
                        },
                        "secondaryName": {
                            "type": "Compose",
                            "inputs": "@split(coalesce(item()?['labels']?['owner_email_secondary'],''),'@')[0]",
                            "runAfter": {
                                "primaryName": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "mentionTokens": {
                            "type": "Compose",
                            "inputs": "@if(empty(item()?['labels']?['owner_email_secondary']),concat('<at>',outputs('primaryName'),'</at>'),concat('<at>',outputs('primaryName'),'</at> <at>',outputs('secondaryName'),'</at>'))",
                            "runAfter": {
                                "secondaryName": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "mentionEntities": {
                            "type": "Compose",
                            "inputs": "@if(empty(item()?['labels']?['owner_email_secondary']),createArray(json(concat('{\"type\":\"mention\",\"text\":\"<at>',outputs('primaryName'),'</at>\",\"mentioned\":{\"id\":\"',item()?['labels']?['owner_email_primary'],'\",\"name\":\"',outputs('primaryName'),'\"}}'))),createArray(json(concat('{\"type\":\"mention\",\"text\":\"<at>',outputs('primaryName'),'</at>\",\"mentioned\":{\"id\":\"',item()?['labels']?['owner_email_primary'],'\",\"name\":\"',outputs('primaryName'),'\"}}')),json(concat('{\"type\":\"mention\",\"text\":\"<at>',outputs('secondaryName'),'</at>\",\"mentioned\":{\"id\":\"',item()?['labels']?['owner_email_secondary'],'\",\"name\":\"',outputs('secondaryName'),'\"}}'))))",
                            "runAfter": {
                                "mentionTokens": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "작성": {
                            "type": "Compose",
                            "inputs": {
                                "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                                "type": "AdaptiveCard",
                                "version": "1.4",
                                "body": [
                                    {
                                        "type": "TextBlock",
                                        "size": "Large",
                                        "weight": "Bolder",
                                        "color": "@{if(equals(item()?['status'],'firing'),'attention','good')}",
                                        "text": "@{toUpper(item()?['status'])}: @{outputs('mentionTokens')} @{item()?['labels']?['alertname']}"
                                    },
                                    {
                                        "type": "FactSet",
                                        "facts": [
                                            {
                                                "title": "instance",
                                                "value": "@{item()?['labels']?['instance']}"
                                            },
                                            {
                                                "title": "severity",
                                                "value": "@{item()?['labels']?['severity']}"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "TextBlock",
                                        "wrap": true,
                                        "weight": "Bolder",
                                        "text": "@{item()?['annotations']?['summary']}"
                                    },
                                    {
                                        "type": "TextBlock",
                                        "wrap": true,
                                        "text": "@{item()?['annotations']?['description']}"
                                    }
                                ],
                                "msteams": {
                                    "entities": "@outputs('mentionEntities')"
                                }
                            },
                            "runAfter": {
                                "mentionEntities": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "채팅_또는_채널에서_카드_게시": {
                            "runAfter": {
                                "작성": [
                                    "Succeeded"
                                ]
